#!/usr/bin/env python3
"""
Simple `nls` implementation following .github/assets/spec.md:
- No args: list filenames in current directory (non-hidden)
- Args that are files: print the filename
- Args that are directories: print filenames inside that directory (non-hidden)
- -l: long listing similar to `ls -l`, but month is a number; time format:
    - If mtime is in the current year: "MM DD HH:MM"
    - If mtime is from previous years: "MM DD (YYYY)"
"""

import os
import sys
import stat
import pwd
import grp
import datetime


def list_names(path):
    try:
        names = sorted(n for n in os.listdir(path) if not n.startswith('.'))
    except Exception as e:
        print(f"nls: cannot access '{path}': {e}", file=sys.stderr)
        return []
    return names


def long_info(fullpath, name):
    try:
        st = os.lstat(fullpath)
    except Exception as e:
        return f"? ? ? ? ? ? {name}"

    mode = st.st_mode
    mode_str = stat.filemode(mode)
    nlink = st.st_nlink
    try:
        owner = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        owner = str(st.st_uid)
    try:
        group = grp.getgrgid(st.st_gid).gr_name
    except KeyError:
        group = str(st.st_gid)
    size = st.st_size

    mtime = datetime.datetime.fromtimestamp(st.st_mtime)
    now = datetime.datetime.now()
    if mtime.year < now.year:
        time_str = f"{mtime.month} {mtime.day} ({mtime.year})"
    else:
        time_str = f"{mtime.month} {mtime.day} {mtime.hour:02d}:{mtime.minute:02d}"

    return f"{mode_str} {nlink:>2} {owner} {group} {size:>6} {time_str} {name}"


def print_listing(path, long=False):
    if os.path.isdir(path):
        names = list_names(path)
        for name in names:
            full = os.path.join(path, name)
            if long:
                print(long_info(full, name))
            else:
                print(name)
    else:
        # path is a file or does not exist
        base = os.path.basename(path)
        if long:
            print(long_info(path, base))
        else:
            print(base)


def parse_args(argv):
    long = False
    paths = []
    for arg in argv:
        if arg == '-l':
            long = True
        else:
            paths.append(arg)
    return long, paths


def main():
    long, paths = parse_args(sys.argv[1:])
    if not paths:
        paths = ['.']

    for idx, p in enumerate(paths):
        # If multiple paths, do not print header per spec; simply list sequentially
        print_listing(p, long=long)


if __name__ == '__main__':
    main()
